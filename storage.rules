rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /workout-plans/{allPaths=**} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null &&
        (request.auth.token.email == 'pappostudios@gmail.com' ||
         request.auth.token.email == 'kjfitness.info@gmail.com');
    }
  }
}
